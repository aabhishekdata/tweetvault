":"San Francisco","banner_url":"","avatar_url":"https://pbs.twimg.com/profile_images/1902044548936953856/J2jeik0t_200x200.jpg","joined":"Fri Jun 25 03:08:49 +0000 2010","protected":false,"website":{"url":"https://borischerny.com","display_url":"borischerny.com"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":23,"reposts":39,"likes":1585,"bookmarks":922,"quotes":14,"embed_card":"summary_large_image","created_at":"Fri Jan 02 19:59:03 +0000 2026","created_timestamp":1767383943,"possibly_sensitive":false,"views":428069,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":{"screen_name":"bcherny","status":"2007179852047335529","url":"https://x.com/bcherny/status/2007179852047335529","profile_url":"https://x.com/bcherny"},"media":{"all":[{"type":"photo","id":"2007168430890463232","url":"https://pbs.twimg.com/media/G9rlDa-asAAXlHx.jpg?name=orig","width":930,"height":774}],"photos":[{"type":"photo","id":"2007168430890463232","url":"https://pbs.twimg.com/media/G9rlDa-asAAXlHx.jpg?name=orig","width":930,"height":774}]},"provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/bcherny/status/2007179856266789204","id":"2007179856266789204","text":"11/ Claude Code uses all my tools for me. It often searches and posts to Slack (via the MCP server), runs BigQuery queries to answer analytics questions (using bq CLI), grabs error logs from Sentry, etc. The Slack MCP configuration is checked into our .mcp.json and shared with the team.","raw_text":{"text":"11/ Claude Code uses all my tools for me. It often searches and posts to Slack (via the MCP server), runs BigQuery queries to answer analytics questions (using bq CLI), grabs error logs from Sentry, etc. The Slack MCP configuration is checked into our .mcp.json and shared with the team.","display_text_range":[0,287],"facets":[{"type":"media","indices":[278,301],"id":"2007169465516281856","display":"pic.x.com/S4nAHlHbvX","original":"https://t.